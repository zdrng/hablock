    <string name="settings_guide_title">Apparaateigenaar instellen</string>
    <string-array name="settings_guide_steps">
        <item>Verwijder elk Google- en werkaccount van het apparaat (Instellingen → Accounts).</item>
        <item>Zet ontwikkelaarsopties aan, dan USB-foutopsporing.</item>
        <item>Verbind de telefoon met een computer waarop adb is geïnstalleerd.</item>
        <item>Voer het onderstaande commando uit, exact zoals geschreven.</item>
        <item>Heropen Hablock. Apparaateigenaar staat op Aan.</item>
    </string-array>
    <string name="settings_guide_copy_command">Commando kopiëren</string>
    <string name="settings_guide_warning">Dit werkt alleen op een apparaat dat net is gereset zonder accounts. Zodra Hablock eigenaar is, is de enige weg terug de timer van 3 dagen hieronder.</string>
