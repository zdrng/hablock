    <string name="settings_guide_title">Configurer le propriétaire de l\'appareil</string>
    <string-array name="settings_guide_steps">
        <item>Retire tous les comptes Google et professionnels de l\'appareil (Réglages → Comptes).</item>
        <item>Active les options développeur, puis le débogage USB.</item>
        <item>Connecte le téléphone à un ordinateur avec adb installé.</item>
        <item>Exécute la commande ci-dessous, exactement telle qu\'écrite.</item>
        <item>Rouvre Hablock. Propriétaire de l\'appareil affiche Activé.</item>
    </string-array>
    <string name="settings_guide_copy_command">Copier la commande</string>
    <string name="settings_guide_warning">Ça ne fonctionne que sur un appareil fraîchement réinitialisé sans aucun compte. Une fois qu\'Hablock possède l\'appareil, le seul retour est le minuteur de 3 jours ci-dessous.</string>
