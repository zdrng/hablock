    <string name="settings_guide_title">Indstil enhedsejer</string>
    <string-array name="settings_guide_steps">
        <item>Fjern alle Google- og arbejdskonti fra enheden (Indstillinger → Konti).</item>
        <item>Slå udviklerindstillinger til, og derefter USB-fejlfinding.</item>
        <item>Forbind telefonen til en computer med adb installeret.</item>
        <item>Kør kommandoen herunder, præcis som skrevet.</item>
        <item>Genåbn Hablock. Enhedsejer viser Til.</item>
    </string-array>
    <string name="settings_guide_copy_command">Kopiér kommando</string>
    <string name="settings_guide_warning">Dette virker kun på en nyligt nulstillet enhed uden konti. Når Hablock ejer enheden, er den eneste vej tilbage 3-dages opgivelses-timeren herunder.</string>
