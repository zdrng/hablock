    <string name="rationale_title">Why Hablock reads health data</string>
    <string name="rationale_reads">Hablock reads your steps, exercise sessions and mindfulness minutes to decide whether the day\'s conditions are met.</string>
    <string name="rationale_private">It reads on the device, only for today\'s window, and holds no network permission. Nothing leaves the phone.</string>
