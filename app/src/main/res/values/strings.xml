        <item quantity="one">Open %1$s — %2$d minute</item>
        <item quantity="other">Open %1$s — %2$d minutes</item>
    </plurals>
    <string name="blocked_hc_warning">Health Connect can\'t be read right now, so those goals count as zero. Fix it from the Blocks screen.</string>

    <string name="notif_channel_name">Hablock</string>
    <string name="notif_session_ended_title">%1$s is locked again</string>
    <plurals name="notif_session_ended_text">
        <item quantity="one">That was your minute. The goals nudged up a little — next round\'s on you.</item>
        <item quantity="other">That was your %1$d minutes. The goals nudged up a little — next round\'s on you.</item>
    </plurals>
    <string name="notif_relinquish_title">The 3-day timer is done</string>
