    <string name="emergency_release_hint">Slip tidligt for at annullere. Slip ved nul for at låse op.</string>
    <string name="emergency_accessible_hint">Ved nul skal du bruge handlingen for langt tryk igen for at bekræfte. Annuller for at stoppe.</string>
