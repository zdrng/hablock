    <string name="rationale_title">Hvorfor Hablock læser sundhedsdata</string>
    <string name="rationale_reads">Hablock læser dine skridt, træningspas og mindfulness-minutter for at vurdere, om dagens betingelser er opfyldt.</string>
    <string name="rationale_private">Det læser på enheden, kun for dagens vindue, og har ingen netværkstilladelse. Intet forlader telefonen.</string>
