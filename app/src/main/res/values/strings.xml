    <string name="emergency_seconds">%1$d s</string>
    <string name="emergency_hold_hint">Hold for 10 seconds. Progress appears above your finger.</string>
    <string name="emergency_release_hint">Release early to cancel. At zero, release to unlock.</string>
    <string name="emergency_accessible_hint">At zero, use the long-press action again to confirm. Cancel to stop.</string>
