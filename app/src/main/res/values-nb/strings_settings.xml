    <string name="settings_guide_title">Sett opp enhets eier</string>
    <string-array name="settings_guide_steps">
        <item>Fjern alle Google- og jobbkontoer fra enheten (Innstillinger → Kontoer).</item>
        <item>Slå på utvikleralternativer, og deretter USB-feilsøking.</item>
        <item>Koble telefonen til en datamaskin med adb installert.</item>
        <item>Kjør kommandoen nedenfor, nøyaktig som skrevet.</item>
        <item>Åpne Hablock igjen. Enhets eier viser På.</item>
    </string-array>
    <string name="settings_guide_adb_command" translatable="false">adb shell dpm set-device-owner dev.hablock.app/.system.HablockDeviceAdminReceiver</string>
    <string name="settings_guide_copy_command">Kopier kommando</string>
    <string name="settings_guide_warning">Dette virker kun på en nylig nullstilt enhet uten kontoer. Når Hablock eier enheten, er eneste vei tilbake nedtellingen på 3 dager nedenfor.</string>
